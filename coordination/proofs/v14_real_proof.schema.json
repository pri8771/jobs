{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "V1.4 Real Proof Redacted Evidence",
  "description": "Closed schema for the redacted candidate bundle emitted by scripts/run_v14_real_proof.py. RP14-T1: a runner output is a REAL_PROOF_CANDIDATE; only scripts/verify_v14_real_proof.py can produce REAL_PROOF_PASS, and it does so in a separate receipt. RP14-T5: the top-level key set is a closed allowlist that must stay identical to verify_v14_real_proof.ALLOWED_TOP_LEVEL_KEYS.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "result",
    "proof_run_id",
    "run_timestamp_utc",
    "code_commit_sha",
    "job_url",
    "job_title",
    "company",
    "job_snapshot_sha256",
    "candidate_profile_source_class",
    "candidate_profile_version",
    "candidate_unresolved_fact_categories",
    "resume_family",
    "resume_variant",
    "resume_version",
    "resume_source_sha256",
    "resume_source_byte_count",
    "model_provider",
    "model_name",
    "model_origin",
    "generation_origin",
    "generation_engine",
    "packet_id",
    "packet_hash",
    "resume_artifact_sha256",
    "cover_letter_artifact_sha256",
    "manifest_sha256",
    "is_live_ready",
    "resolved_answers_count",
    "unresolved_questions",
    "questions_count",
    "read_back_verification",
    "mock_or_fixture_inputs_present"
  ],
  "properties": {
    "result": {
      "description": "RP14-T1: the runner emits a candidate only; a self-declared REAL_PROOF_PASS is rejected.",
      "const": "REAL_PROOF_CANDIDATE"
    },
    "proof_run_id": {
      "type": "string",
      "minLength": 1
    },
    "run_timestamp_utc": {
      "type": "string",
      "format": "date-time",
      "minLength": 1
    },
    "code_commit_sha": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{7,40}$"
    },
    "job_url": {
      "type": "string",
      "format": "uri",
      "pattern": "^https?://"
    },
    "job_title": {
      "type": "string",
      "minLength": 1
    },
    "company": {
      "type": "string",
      "minLength": 1
    },
    "job_snapshot_sha256": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{64}$"
    },
    "candidate_profile_source_class": {
      "enum": [
        "PRIVATE_LOCAL",
        "PRIVATE_CONNECTED_SOURCE"
      ]
    },
    "candidate_profile_version": {
      "type": [
        "integer",
        "string"
      ]
    },
    "candidate_unresolved_fact_categories": {
      "description": "Counts per unresolved candidate-fact category; counts only, never the private facts themselves.",
      "type": "object",
      "additionalProperties": {
        "type": "integer",
        "minimum": 0
      }
    },
    "resume_family": {
      "type": "string",
      "minLength": 1
    },
    "resume_variant": {
      "type": "string",
      "minLength": 1
    },
    "resume_version": {
      "type": [
        "integer",
        "string"
      ]
    },
    "resume_source_sha256": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{64}$"
    },
    "resume_source_byte_count": {
      "type": "integer",
      "minimum": 1
    },
    "model_provider": {
      "description": "Null for the deterministic V1.4 path; matches the verifier's model_provider rule.",
      "enum": [
        null,
        "deterministic-production"
      ]
    },
    "model_name": {
      "type": [
        "string",
        "null"
      ]
    },
    "model_origin": {
      "description": "RP14-T6: deterministic generation labeling is mandatory for the V1.4 proof.",
      "const": "deterministic"
    },
    "generation_origin": {
      "description": "RP14-T6: deterministic generation labeling is mandatory for the V1.4 proof.",
      "const": "deterministic"
    },
    "generation_engine": {
      "const": "deterministic-canonical-renderer"
    },
    "packet_id": {
      "type": "string",
      "pattern": "^[0-9a-fA-F-]{36}$"
    },
    "packet_hash": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{64}$"
    },
    "resume_artifact_sha256": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{64}$"
    },
    "cover_letter_artifact_sha256": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{64}$"
    },
    "manifest_sha256": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{64}$"
    },
    "is_live_ready": {
      "type": "boolean"
    },
    "resolved_answers_count": {
      "type": "integer",
      "minimum": 0
    },
    "unresolved_questions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "questions_count": {
      "type": "integer",
      "minimum": 0
    },
    "read_back_verification": {
      "const": true
    },
    "mock_or_fixture_inputs_present": {
      "const": false
    }
  }
}
