# Database (Docker Compose maps to host port 5433 by default to avoid collisions with any local PostgreSQL)
DATABASE_URL=postgresql+psycopg://jobs:jobs@localhost:5433/jobs
POSTGRES_PORT=5433

# Gmail OAuth
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_TOKEN_PATH=.local/gmail_token.json

# Model gateway
MODEL_GATEWAY_BASE_URL=
MODEL_GATEWAY_API_KEY=

# Optional provider keys
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=

# Runtime
LOG_LEVEL=INFO
ENVIRONMENT=development
